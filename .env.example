# Copie para .env (ao lado do docker-compose.yml) e ajuste. Tudo é opcional.

# Pastas do host no lugar dos volumes do Docker (precisam ser do UID 1000,
# o usuário do container). Sem a chave: volumes nomeados "data" e "geodata".
# SCRATCH_DATA_DIR=/srv/scratch-map/data
# SCRATCH_GEODATA_DIR=/srv/scratch-map/geodata

# Endereço publicado: só a porta (todas as interfaces) ou IP:porta, para
# deixar a mesma porta livre no IP da tailnet para o `tailscale serve` (HTTPS).
# SCRATCH_PORT=5020
# SCRATCH_PORT=192.168.0.10:5020

# Teto de RAM do container (um upload grande de fotos não derruba a máquina).
# SCRATCH_MEM_LIMIT=768m
