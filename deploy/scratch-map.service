[Unit]
Description=Scratch Map - mapa pessoal de lugares visitados (web app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/scratch-map
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/projects/scratch-map/venv/bin/gunicorn --bind 0.0.0.0:5020 --workers 1 --threads 4 --timeout 180 --control-socket %t/scratch-map.ctl app:app
# HTTPS (para instalar o app no Android; veja o README, "No celular"): troque o
# --bind por 127.0.0.1:5021 e ligue scratch-map-tls (HTTP e HTTPS na 5020) e o
# timer scratch-map-cert (renova o certificado do Tailscale).
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
# teto de memória: um upload grande não derruba uma máquina com pouca RAM
MemoryMax=768M

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/projects/scratch-map/data
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes

[Install]
WantedBy=default.target
